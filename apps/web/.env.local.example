# Copia este archivo a .env.local y llena con tus credenciales

# ============================================
# MERCADO PAGO CONFIGURATION
# ============================================
# Obtén tus credenciales en: https://www.mercadopago.com.mx/developers

# Access Token (Server-side)
MERCADO_PAGO_ACCESS_TOKEN=

# Public Key (Client-side) - Necesario en el navegador
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# Webhook Secret - Panel MP → Tu integración → Webhooks → Secret
# Si se configura, se valida la firma de cada notificación entrante
MERCADO_PAGO_WEBHOOK_SECRET=

# ============================================
# APP CONFIGURATION
# ============================================
# URL base de la aplicación (localhost para desarrollo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Forzar sandbox en el frontend (true/false)
NEXT_PUBLIC_MP_USE_SANDBOX=true

# URL pública base (ngrok, Cloudflare Tunnel, etc.) para webhooks en local
MP_PUBLIC_BASE_URL=

# ============================================
# WEBHOOK CONFIGURATION (Opcional)
# ============================================
# URL para recibir notificaciones de Mercado Pago
# MERCADO_PAGO_NOTIFICATION_URL=https://tudominio.com/api/payment/webhook

# ============================================
# VERCEL KV CONFIGURATION
# ============================================
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ============================================
# ADMIN AUTH CONFIGURATION
# ============================================
ADMIN_USER=admin
# Genera el hash con bcrypt (bcryptjs) y pégalo aquí
ADMIN_PASSWORD_HASH=
# Opcional: lista JSON de admins adicionales
# Ejemplo:
# ADMIN_USERS_JSON=[{"username":"superAdmin","passwordHash":"$2a$12$...","role":"superadmin"}]
ADMIN_USERS_JSON=
ADMIN_SESSION_SECRET=
